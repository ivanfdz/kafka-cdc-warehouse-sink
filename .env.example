# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Placeholders only. Replace every REPLACE_WITH_* value; do not leave a real
# credential in this file.

# --- general ----------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# --- kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PLAINTEXT locally, SASL_SSL against a managed cluster.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=REPLACE_WITH_KAFKA_SASL_USERNAME
KAFKA_SASL_PASSWORD=REPLACE_WITH_KAFKA_SASL_PASSWORD
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_INTERVAL_MS=900000
KAFKA_SESSION_TIMEOUT_MS=600000
KAFKA_HEARTBEAT_INTERVAL_MS=3000

# --- schema registry --------------------------------------------------------
SCHEMA_REGISTRY_URL=http://localhost:8081
# "user:password" form. Leave unset when the registry needs no auth.
SCHEMA_REGISTRY_BASIC_AUTH=REPLACE_WITH_SCHEMA_REGISTRY_USER:REPLACE_WITH_SCHEMA_REGISTRY_PASSWORD

# --- topics -----------------------------------------------------------------
CDC_TOPIC=cdc.dev.orders
CONSUMER_GROUP=cdc-warehouse-sink
# Optional. Set only to republish applied records downstream.
# SINK_OUTPUT_TOPIC=cdc.dev.orders.applied

# --- batching ---------------------------------------------------------------
BATCH_SIZE=500
POLL_TIMEOUT_SECONDS=10
SLEEP_INTERVAL_SECONDS=5
CATALOG_SOURCE_ID=12
DEFAULT_LINK_SCORE=2

# --- warehouse --------------------------------------------------------------
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_DATABASE=warehouse
WAREHOUSE_SCHEMA=public
WAREHOUSE_USER=REPLACE_WITH_WAREHOUSE_USER
WAREHOUSE_PASSWORD=REPLACE_WITH_WAREHOUSE_PASSWORD
WAREHOUSE_CONNECT_TIMEOUT=10
